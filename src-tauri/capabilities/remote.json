{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-localhost",
  "description": "允许 localhost 页面(外部 URL)调用 Tauri IPC:dialog 插件弹原生文件选择器(PC 端加号添加本地文件引用)",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
