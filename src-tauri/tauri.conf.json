{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tinbox",
  "version": "0.1.0",
  "identifier": "com.tinbox.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
